      </air:Flight>
    </air:hasFlight>
    <air:price>1200</air:price>
    <air:startTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"
    >2025-05-01T00:00:00</air:startTime>
    <air:bookedBy>
      <air:Customer rdf:about="http://example.org/airline#Aafaq">
        <air:passport>P123456</air:passport>
        <air:name>Aafaq Ahmad</air:name>
      </air:Customer>
    </air:bookedBy>
  </air:Trip>
  <air:Trip rdf:about="http://example.org/airline#Trip3">
    <air:hasFlight>
      <air:Flight rdf:about="http://example.org/airline#F12">
        <air:endTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"

    </air:hasFlight>
    <air:hasFlight>
      <air:Flight rdf:about="http://example.org/airline#F1">
        <air:endTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"
        >2025-05-01T03:00:00</air:endTime>
        <air:startTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"
        >2025-05-01T00:00:00</air:startTime>
        <air:flightOrder>1</air:flightOrder>
        <air:toAirport rdf:resource="http://example.org/airline#JFK"/>

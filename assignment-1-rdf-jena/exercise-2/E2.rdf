  <air:Airline rdf:about="http://example.org/airline#GlobalAirline">
    <air:hasAirport rdf:resource="http://example.org/airline#LHR"/>
    <air:hasAirport rdf:resource="http://example.org/airline#FCO"/>
    <air:hasAirport rdf:resource="http://example.org/airline#JFK"/>
    <air:hasAirport rdf:resource="http://example.org/airline#BER"/>
    <air:employees>1500</air:employees>
    <air:manager>Dr. Smith</air:manager>
  </air:Airline>
  <air:FlightConnection rdf:about="http://example.org/airline#C3">
    <air:planeModel rdf:resource="http://example.org/airline#Boeing737"/>
    <air:durationHours>3</air:durationHours>
    <air:toAirport rdf:resource="http://example.org/airline#LHR"/>
    <air:fromAirport rdf:resource="http://example.org/airline#FCO"/>
  </air:FlightConnection>
  <air:FlightConnection rdf:about="http://example.org/airline#C1">
    <air:planeModel rdf:resource="http://example.org/airline#Boeing737"/>
    <air:durationHours>8</air:durationHours>
    <air:toAirport rdf:resource="http://example.org/airline#JFK"/>
    <air:fromAirport rdf:resource="http://example.org/airline#BER"/>
  </air:FlightConnection>
  <rdf:Description rdf:about="http://example.org/airline#Flight">
    <rdfs:subClassOf rdf:resource="http://example.org/airline#FlightConnection"/>
  </rdf:Description>
